{
  "manifest_version": 3,
  "name": "Focus Mode",
  "version": "1.4",
  "description": "ATI Focus Mode with targeted media hiding, an article heading and sidebar switching.",
  "icons": {
    "16": "icon_16x16.png",
    "32": "icon_32x32.png",
    "48": "icon_48x48.png",
    "128": "icon_128x128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lms.atitesting.com/*",
        "https://pages-delivery.atitesting.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://lms.atitesting.com/*"],
      "js": ["filenames.js"],
      "run_at": "document_idle"
    }
  ]
}
